[Unit]
Description=PodStack privileged helper (allowlisted setup actions)
Documentation=https://github.com/marcos2872/podstack
After=dbus.service
Requires=dbus.service

[Service]
Type=dbus
BusName=dev.podstack.Helper1
ExecStart=/usr/libexec/podstack/podstack-helper
User=root
Group=root
# Sem NoNewPrivileges: o dnf precisa da transição SELinux para rpm_script_t
# ao executar scriptlets de RPM (nnp_transition é negado com a opção ligada).
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
