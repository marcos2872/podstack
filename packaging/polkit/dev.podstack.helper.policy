<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

  <vendor>PodStack</vendor>
  <vendor_url>https://github.com/marcos2872/podstack</vendor_url>

  <action id="dev.podstack.helper.install-packages">
    <description>Instalar pacotes para o PodStack</description>
    <message>O PodStack precisa instalar pacotes do sistema para preparar o ambiente.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/podstack/podstack-helper</annotate>
  </action>

  <action id="dev.podstack.helper.remove-packages">
    <description>Remover o Docker do sistema</description>
    <message>O PodStack removerá os pacotes do Docker. Containers, imagens, redes e volumes do Docker podem ser perdidos.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/podstack/podstack-helper</annotate>
  </action>

  <action id="dev.podstack.helper.open-ports">
    <description>Abrir portas no firewall para o PodStack</description>
    <message>O PodStack abrirá as portas publicadas de um container no firewall e permitirá acesso de outros dispositivos da rede local.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/podstack/podstack-helper</annotate>
  </action>

  <action id="dev.podstack.helper.close-ports">
    <description>Fechar portas no firewall para o PodStack</description>
    <message>O PodStack removerá as regras de firewall das portas publicadas de um container, encerrando o acesso pela rede local.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/podstack/podstack-helper</annotate>
  </action>

  <action id="dev.podstack.helper.trust-ca">
    <description>Confiar na CA local do PodStack</description>
    <message>O PodStack adicionará a CA local ao trust store do sistema para validar os certificados HTTPS dos domínios locais. A remoção desfaz isso.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/podstack/podstack-helper</annotate>
  </action>

  <action id="dev.podstack.helper.bind-ports">
    <description>Ativar as portas 80/443 para o PodStack</description>
    <message>O PodStack instalará unidades systemd para encaminhar as portas 80 e 443 ao proxy local do usuário.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/podstack/podstack-helper</annotate>
  </action>

  <action id="dev.podstack.helper.dns-zone">
    <description>Configurar DNS local para o PodStack</description>
    <message>O PodStack instalará um drop-in no systemd-resolved para resolver *.podstack.local para 127.0.0.1. A remoção desfaz a configuração.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/podstack/podstack-helper</annotate>
  </action>

  <action id="dev.podstack.helper.stage-update">
    <description>Validar e preparar o pacote de atualização do PodStack</description>
    <message>O PodStack validará a assinatura e o SHA-256 do pacote de atualização antes de instalá-lo.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/podstack/podstack-helper</annotate>
  </action>

  <action id="dev.podstack.helper.install-update">
    <description>Instalar a atualização do PodStack</description>
    <message>O PodStack instalará o pacote validado em uma unidade transiente e reiniciará o app.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/podstack/podstack-helper</annotate>
  </action>

  <action id="dev.podstack.helper.get-update-status">
    <description>Consultar o progresso da atualização do PodStack</description>
    <message>O PodStack consultará o progresso da atualização em andamento.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/podstack/podstack-helper</annotate>
  </action>

  <action id="dev.podstack.helper.get-logs">
    <description>Ler os logs das operações de atualização do PodStack</description>
    <message>O PodStack lerá os logs root das operações de atualização deste usuário.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/podstack/podstack-helper</annotate>
  </action>

</policyconfig>
