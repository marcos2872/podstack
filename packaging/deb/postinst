#!/bin/sh
set -e

if command -v systemctl >/dev/null 2>&1; then
    # O socket do usuário sobe sob demanda na primeira conexão da GUI/CLI.
    systemctl --global enable podstack.socket >/dev/null 2>&1 || true
    # O helper é um serviço de sistema (D-Bus/polkit); sem enable --now o app
    # não encontra o nome dev.podstack.Helper1 depois da instalação.
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable --now podstack-helper.service >/dev/null 2>&1 || true
fi

exit 0
