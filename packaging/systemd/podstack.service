[Unit]
Description=PodStack daemon
Requires=podstack.socket
After=podstack.socket

[Service]
Type=simple
ExecStart=/usr/bin/podstackd
Restart=on-failure
RestartSec=2
TimeoutStopSec=20

# Hardening básico. O daemon lança `podman` (Compose/builds) como filho:
# NoNewPrivileges impediria a transição SELinux para container_runtime_t e
# SystemCallFilter bloquearia fsopen/outras syscalls usadas pelo Podman.
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# Estas diretivas criam os diretórios antes do sandbox: ReadWritePaths não
# pode apontar para um caminho que ainda não existe no primeiro start.
StateDirectory=podstack
CacheDirectory=podstack
ConfigurationDirectory=podstack
ReadWritePaths=%h/.config %h/.local %h/.cache %t
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
LockPersonality=yes

[Install]
WantedBy=default.target
