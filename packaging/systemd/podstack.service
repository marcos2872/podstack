[Unit]
Description=PodStack daemon
Requires=podstack.socket
After=podstack.socket

[Service]
Type=simple
ExecStart=/usr/bin/podstackd
Restart=on-failure
RestartSec=2
TimeoutStopSec=20

# QEMU/virtiofsd rodam em scopes próprios (`systemd-run --user --scope`) para
# sobreviver ao restart do daemon. KillMode=process é apenas defesa em
# profundidade: não move processos de cgroup, mas evita que um filho que ainda
# esteja no cgroup do serviço seja morto junto com o podstackd.
KillMode=process

# Hardening básico. O daemon lança `podman` (Compose/builds) como filho:
# NoNewPrivileges impediria a transição SELinux para container_runtime_t e
# SystemCallFilter bloquearia fsopen/outras syscalls usadas pelo Podman.
#
# Não use ProtectHome/PrivateTmp aqui. O daemon roda como o usuário e precisa:
#   - gravar ~/.ssh/config ao criar/renomear machines;
#   - gravar downloads/exportações no caminho escolhido pelo usuário;
#   - servir diretórios compartilhados pelo virtiofsd.
# QEMU/virtiofsd são lançados em scopes transientes que herdam o mount
# namespace deste serviço, então restringir $HOME ou /tmp quebraria machines,
# transfers de arquivos e shares. ProtectSystem=full mantém /usr, /boot e /etc
# somente-leitura sem afetar /var (tmp do podman CLI) nem o home.
ProtectSystem=full
StateDirectory=podstack
CacheDirectory=podstack
ConfigurationDirectory=podstack
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
LockPersonality=yes

[Install]
WantedBy=default.target
